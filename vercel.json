{
  "services": {
    "backend": {
      "root": "backend",
      "framework": "rust",
      "entrypoint": "src/main.rs"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
